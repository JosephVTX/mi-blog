---
import '../styles/global.css';
import { SITE } from '../config';
import { locales, type Dict } from '../i18n';
interface Props { t: Dict; jsonLd?: object[] }
const { t, jsonLd = [] } = Astro.props;
const title = t.meta.title;
const description = t.meta.description;
const canonical = new URL(t.path, SITE.url).href;
const og = new URL(SITE.ogImage, SITE.url).href;
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#fbf7f2" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {locales.map((l) => <link rel="alternate" hreflang={l.htmlLang} href={new URL(l.path, SITE.url).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', SITE.url).href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={t.ogLocale} />
    {locales.filter((l) => l !== t).map((l) => <meta property="og:locale:alternate" content={l.ogLocale} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="article:published_time" content={SITE.published} />
    <meta property="article:author" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
